NODE_ENV=production
PORT=3001
SQLITE_PATH=/app/data/data.sqlite

# ===== AI Provider =====
# official: 仅 DeepSeek 官方 API
# gateway : 免费池（AI_PROVIDERS_JSON）→ 自动故障切换 → 官方兜底
AI_MODE=official
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_SYSTEM_PROMPT_FILE=prompts/Prompt.md
# 官方请求的附加参数（禁用推理可大幅降低首字延迟与费用）
DEEPSEEK_EXTRA_BODY={"reasoning_effort":"none","max_tokens":1000}

# ===== AI Router 调参（默认值见下） =====
# 首字超时：免费池每个模型最多等这么久没有首个有效字就切换
AI_FIRST_TOKEN_TIMEOUT_MS=2000
# 免费池累计预算：超过后直接跳官方兜底
AI_GATEWAY_BUDGET_MS=6000
# 单次上游请求总超时
DEEPSEEK_TIMEOUT_MS=90000
# 并发与队列
MODEL_CONCURRENCY=6
MODEL_QUEUE_MAX=50

# ===== Gateway 模式的免费模型池（可选） =====
# OpenAI 兼容协议的有序列表，fallback:true 的是官方兜底（自动追加，无需手写）
# AI_PROVIDERS_JSON=[{"name":"cpa-free-1","baseURL":"http://100.123.120.16:8317/v1","apiKey":"sk-xxx","model":"gemini-2.0-flash"},{"name":"cpa-free-2","baseURL":"http://100.123.120.16:8317/v1","apiKey":"sk-xxx","model":"gpt-4o-mini"}]

# ===== 安全 =====
JWT_SECRET=change-me-in-production

# ===== Telegram 管理机器人（可选，不配则不启动） =====
# TG_BOT_TOKEN=123456:ABC
# TG_ADMIN_IDS=10086
# TG_PROXY=http://127.0.0.1:7890
